links.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/linkfile.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
