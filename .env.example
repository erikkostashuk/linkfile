# ---------------------------------------------------------------------------
# Linkfile environment configuration
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# Every value here is optional except where noted. Linkfile boots with sensible
# defaults so `npm run dev` works immediately after cloning.
# ---------------------------------------------------------------------------

# Public origin of your deployed site, with no trailing slash.
# Used for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
# This is the only variable exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HTTP Basic Auth credentials for the /stats dashboard.
# Leave BOTH blank to keep /stats completely inaccessible (it returns 404).
# There are no defaults: unset credentials never mean "open to the public".
STATS_USERNAME=
STATS_PASSWORD=

# Where click events are recorded.
#   auto     - use PostgreSQL when DATABASE_URL is set, otherwise the file store
#              (on Vercel without DATABASE_URL, recording is disabled — see README)
#   file     - always use the append-only log file
#   postgres - always use PostgreSQL; fails loudly when DATABASE_URL is missing
CLICK_STORE=auto

# Path to the append-only click log used by the file store.
# Relative paths resolve from the project root. Mount this as a volume in Docker.
CLICK_LOG_PATH=.data/clicks.log

# Standard PostgreSQL connection string. Required when CLICK_STORE=postgres.
# Most hosted providers need `?sslmode=require`.
# Example: postgres://user:password@host:5432/linkfile?sslmode=require
DATABASE_URL=
